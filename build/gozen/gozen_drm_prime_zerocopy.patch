+// A DRM PRIME frame (V4L2 request decoders such as the Rockchip rkvdec, Rockchip MPP): NV12 in one dma-buf. The frame
+// is referenced, so its buffer stays with the decoder's pool, and imported once per buffer (identified by the dma-buf's inode).
+int64_t GoZenZeroCopy::_hold_drm(const AVFrame* frame, int generation) {
+	const AVDRMFrameDescriptor* d = (const AVDRMFrameDescriptor*)frame->data[0];
+	if (!d || d->nb_layers < 1 || d->nb_objects < 1)
+		return -1;
+	const AVDRMLayerDescriptor& layer = d->layers[0];
+	if (layer.format != DRM_FORMAT_NV12_ || layer.nb_planes != 2 || layer.planes[0].object_index != layer.planes[1].object_index)
+		return -1; // only NV12 in one buffer (what the NV12 shader of video_playback.gd draws)
+	const AVDRMObjectDescriptor& object = d->objects[layer.planes[0].object_index];
+	struct stat st;
+	if (object.fd < 0 || fstat(object.fd, &st) != 0)
+		return -1;
+
+	Held held;
+	held.drm = true;
+	held.generation = generation;
+	held.index = (uint32_t)st.st_ino;
+	held.base = (const void*)(uintptr_t)st.st_ino;
+	held.length = object.size;
+	held.fd = object.fd;
+	held.modifier = (object.format_modifier == DRM_MOD_INVALID_) ? 0 : object.format_modifier;
+	held.layout.format = AV_PIX_FMT_NV12;
+	held.layout.width = frame->width;
+	held.layout.height = frame->height;
+	for (int i = 0; i < 2; i++) {
+		held.layout.offset[i] = (int)layer.planes[i].offset;
+		held.layout.pitch[i] = (int)layer.planes[i].pitch;
+		if (held.layout.pitch[i] <= 0)
+			return -1;
+	}
+	if (!(held.frame = av_frame_clone(frame)))
+		return -1;
+
+	std::lock_guard<std::mutex> lock(mutex);
+	held.id = next_id++;
+	pending.push_back(held);
+	return held.id;
+}
