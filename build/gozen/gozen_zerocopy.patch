diff --git a/src/gozen_v4l2.c b/src/gozen_v4l2.c
new file mode 100644
--- /dev/null
+++ b/src/gozen_v4l2.c
@@ -0,0 +1,104 @@
+// The V4L2 M2M decoder's internals that zero-copy needs (Raspberry Pi 4, bcm2835-codec): FFmpeg 7.1 has no
+// drm_prime output for it, so a decoded frame's V4L2 buffer is found from the frame (its buffer's opaque is the
+// internal V4L2Buffer) and exported as a dmabuf. Also a restart of the decoder in place (a seek or a loop) instead
+// of closing and reopening /dev/video10. C, not C++: FFmpeg's internal headers use C11 atomics. FFmpeg is built
+// statically with GoZen at a pinned revision, so its internal structs are the ones included here.
+#ifdef __linux__
+
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <sys/ioctl.h>
+
+#include "libavcodec/avcodec.h"
+#include "libavcodec/v4l2_buffers.h"
+#include "libavcodec/v4l2_context.h"
+#include "libavcodec/v4l2_m2m.h"
+
+#include "gozen_v4l2.h"
+
+
+static int _is_v4l2m2m(const AVCodecContext* avctx) {
+	return avctx && avctx->codec && avctx->codec->wrapper_name && !strcmp(avctx->codec->wrapper_name, "v4l2m2m") &&
+		   avctx->priv_data;
+}
+
+
+int gozen_v4l2_frame_buffer(const AVCodecContext* avctx, const AVFrame* frame, GozenV4L2Buffer* out) {
+	if (!_is_v4l2m2m(avctx) || !frame || !frame->buf[0] || frame->buf[1])
+		return -1; // not a V4L2 frame, or one with a buffer per plane (bcm2835-codec gives one buffer for all)
+	const V4L2Buffer* vb = av_buffer_get_opaque(frame->buf[0]);
+	if (!vb || !vb->context || !vb->context_ref || V4L2_TYPE_IS_OUTPUT(vb->context->type) || vb->num_planes != 1)
+		return -1;
+	out->context = vb->context_ref;
+	out->fd = vb->context_ref->fd;
+	out->type = vb->buf.type;
+	out->index = vb->buf.index;
+	out->base = vb->plane_info[0].mm_addr;
+	out->length = vb->plane_info[0].length;
+	return 0;
+}
+
+
+int gozen_v4l2_export(const GozenV4L2Buffer* buffer) {
+	struct v4l2_exportbuffer e;
+	memset(&e, 0, sizeof(e));
+	e.type = buffer->type;
+	e.index = buffer->index;
+	e.plane = 0;
+	e.flags = O_RDONLY | O_CLOEXEC;
+	if (ioctl(buffer->fd, VIDIOC_EXPBUF, &e) < 0)
+		return -errno;
+	return e.fd;
+}
+
+
+// The stateful decoder's seek (Documentation/userspace-api/media/v4l/dev-decoder.rst): STREAMOFF on both queues
+// drops every queued packet and frame and ends a drain (after the end of the file), STREAMON again, then the next
+// packets from a key frame. Capture buffers the caller still holds (frames being shown) stay out; they go back to
+// the driver when released, as before. avcodec_flush_buffers() first resets FFmpeg's own draining state.
+int gozen_v4l2_restart(AVCodecContext* avctx) {
+	if (!_is_v4l2m2m(avctx))
+		return -1;
+	V4L2m2mContext* s = ((V4L2m2mPriv*)avctx->priv_data)->context;
+	if (!s || s->reinit)
+		return -1;
+	V4L2Context* output = &s->output;
+	V4L2Context* capture = &s->capture;
+	int type;
+
+	type = output->type;
+	if (ioctl(s->fd, VIDIOC_STREAMOFF, &type) < 0)
+		return -errno;
+	output->streamon = 0;
+	for (int i = 0; i < output->num_buffers; i++)
+		output->buffers[i].status = V4L2BUF_AVAILABLE;
+
+	if (capture->buffers) {
+		type = capture->type;
+		if (ioctl(s->fd, VIDIOC_STREAMOFF, &type) < 0)
+			return -errno;
+		capture->streamon = 0;
+		for (int i = 0; i < capture->num_buffers; i++)
+			if (capture->buffers[i].status == V4L2BUF_IN_DRIVER)
+				capture->buffers[i].status = V4L2BUF_AVAILABLE;
+	}
+
+	av_packet_unref(&s->buf_pkt);
+	s->draining = 0;
+	output->done = 0;
+	capture->done = 0;
+
+	if (capture->buffers) {
+		if (ioctl(s->fd, VIDIOC_STREAMON, &type) < 0)
+			return -errno;
+		capture->streamon = 1;
+		for (int i = 0; i < capture->num_buffers; i++)
+			if (capture->buffers[i].status == V4L2BUF_AVAILABLE)
+				ff_v4l2_buffer_enqueue(&capture->buffers[i]);
+	}
+	// the output queue starts again with the next packet (v4l2_try_start() in v4l2_m2m_dec.c)
+	return 0;
+}
+
+#endif
