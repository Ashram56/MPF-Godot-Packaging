@@ -0,0 +1,96 @@
+#pragma once
+
+// Zero-copy display of the V4L2 M2M decoder's frames (Raspberry Pi 4, bcm2835-codec, with Godot's OpenGL ES
+// renderer on EGL): a decoded frame stays in the decoder's buffer, which is exported once as a dmabuf
+// (VIDIOC_EXPBUF), imported on the GPU as one EGLImage per plane (EGL_EXT_image_dma_buf_import), bound to GL
+// textures (glEGLImageTargetTexture2DOES) and handed to Godot with RenderingServer.texture_create_from_native_handle().
+// The CPU never reads a pixel: copying a 1080p frame out of the decoder's uncached buffers took 10-15 ms.
+//
+// Frames are held (their AVFrame referenced, so the decoder does not reuse the buffer) from the decode until a few
+// frames after they were shown, so the GPU is done with them. A buffer is imported the first time it carries a frame,
+// then reused for every later frame it carries.
+#ifdef __linux__
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <vector>
+
+#include <godot_cpp/variant/array.hpp>
+#include <godot_cpp/variant/rid.hpp>
+
+struct AVCodecContext;
+struct AVFrame;
+
+class GoZenZeroCopy {
+  public:
+	// Shown frames kept (with their buffers) after the one on screen: the GPU may still draw them for a frame or two.
+	static constexpr int KEEP_SHOWN = 3;
+
+	GoZenZeroCopy() = default;
+	~GoZenZeroCopy(); // render thread (release())
+
+	// Decode thread: takes a reference to frame (a V4L2 M2M frame, YUV420P or NV12 in one buffer) and returns its
+	// id, or -1 when it is not such a frame. generation changes whenever the decoder is reopened.
+	int64_t hold(const AVCodecContext* avctx, const AVFrame* frame, int generation);
+	// Any thread: lets go of the frames held and not shown yet (a seek, a restart).
+	void drop_pending();
+
+	// Render thread: the textures of a held frame (y, u, v; y, uv for NV12), as RIDs for a shader; frames held before
+	// it are let go (they were skipped). Empty when it cannot be shown (failed() then tells whether zero-copy is
+	// impossible here, the caller copying frames from then on).
+	godot::Array show(int64_t id);
+	bool failed() const { return import_failed; }
+
+	// Any thread: frees it on the render thread (GL objects), now when called there.
+	static void release(GoZenZeroCopy* zero_copy);
+
+  private:
+	struct Layout {
+		int format = 0; // AVPixelFormat
+		int width = 0, height = 0;
+		int offset[3] = {}, pitch[3] = {};
+		bool operator==(const Layout& o) const;
+	};
+	struct Held {
+		int64_t id = -1;
+		AVFrame* frame = nullptr;
+		int generation = 0;
+		uint32_t index = 0;
+		const void* base = nullptr;
+		size_t length = 0;
+		int fd = -1;
+		uint32_t type = 0;
+		Layout layout;
+		int import = -1; // in imports, once shown
+	};
+	struct Import {
+		int generation = 0;
+		uint32_t index = 0;
+		const void* base = nullptr;
+		Layout layout;
+		int dmabuf = -1;
+		void* image[3] = {};
+		uint32_t texture[3] = {};
+		godot::RID rid[3];
+		int planes = 0;
+		int refs = 0; // shown frames using it
+		bool stale = false; // its buffer is gone (the decoder was reopened or reallocated its buffers)
+		bool used = false;
+	};
+
+	std::mutex mutex;
+	std::deque<Held> pending; // decoded, not shown yet (oldest first)
+	std::deque<Held> shown; // shown (oldest first), kept KEEP_SHOWN frames
+	std::vector<Import> imports;
+	int64_t next_id = 0;
+	std::atomic<bool> import_failed{false};
+
+	int _import(const Held& held);
+	void _free_import(Import& import);
+	void _unref(Held& held);
+	static void _delete_on_render_thread(int64_t pointer);
+};
+
+#endif
