diff --git a/src/gozen_zerocopy.cpp b/src/gozen_zerocopy.cpp
new file mode 100644
--- /dev/null
+++ b/src/gozen_zerocopy.cpp
@@ -0,0 +1,374 @@
+#include "gozen_zerocopy.hpp"
+
+#ifdef __linux__
+
+#include <dlfcn.h>
+#include <unistd.h>
+
+#include <godot_cpp/classes/image.hpp>
+#include <godot_cpp/classes/rendering_server.hpp>
+#include <godot_cpp/variant/callable_method_pointer.hpp>
+#include <godot_cpp/variant/utility_functions.hpp>
+
+extern "C" {
+#include <libavcodec/avcodec.h>
+#include <libavutil/frame.h>
+#include <libavutil/pixfmt.h>
+}
+
+#include "gozen_v4l2.h"
+
+using namespace godot;
+
+
+// EGL and GL ES entry points, looked up at run time: Godot loads libEGL itself (its OpenGL ES renderer on X11 and
+// Wayland), and this library also runs where there is none (the Jetson, Windows).
+namespace {
+typedef void* EGLDisplay;
+typedef void* EGLImage;
+typedef int EGLint;
+typedef unsigned int GLenum;
+typedef unsigned int GLuint;
+typedef int GLint;
+
+constexpr EGLint EGL_NONE = 0x3038;
+constexpr EGLint EGL_WIDTH = 0x3057;
+constexpr EGLint EGL_HEIGHT = 0x3056;
+constexpr EGLint EGL_LINUX_DMA_BUF_EXT = 0x3270;
+constexpr EGLint EGL_LINUX_DRM_FOURCC_EXT = 0x3271;
+constexpr EGLint EGL_DMA_BUF_PLANE0_FD_EXT = 0x3272;
+constexpr EGLint EGL_DMA_BUF_PLANE0_OFFSET_EXT = 0x3273;
+constexpr EGLint EGL_DMA_BUF_PLANE0_PITCH_EXT = 0x3274;
+constexpr GLenum GL_TEXTURE_2D = 0x0DE1;
+constexpr GLenum GL_TEXTURE_BINDING_2D = 0x8069;
+constexpr GLenum GL_TEXTURE_MAG_FILTER = 0x2800;
+constexpr GLenum GL_TEXTURE_MIN_FILTER = 0x2801;
+constexpr GLenum GL_TEXTURE_WRAP_S = 0x2802;
+constexpr GLenum GL_TEXTURE_WRAP_T = 0x2803;
+constexpr GLint GL_LINEAR = 0x2601;
+constexpr GLint GL_CLAMP_TO_EDGE = 0x812F;
+constexpr uint32_t fourcc(char a, char b, char c, char d) {
+	return (uint32_t)a | ((uint32_t)b << 8) | ((uint32_t)c << 16) | ((uint32_t)d << 24);
+}
+constexpr uint32_t DRM_FORMAT_R8 = fourcc('R', '8', ' ', ' ');
+constexpr uint32_t DRM_FORMAT_GR88 = fourcc('G', 'R', '8', '8');
+
+struct GL {
+	EGLDisplay (*eglGetCurrentDisplay)();
+	EGLImage (*eglCreateImageKHR)(EGLDisplay, void*, unsigned int, void*, const EGLint*);
+	unsigned int (*eglDestroyImageKHR)(EGLDisplay, EGLImage);
+	EGLint (*eglGetError)();
+	void (*glEGLImageTargetTexture2DOES)(GLenum, void*);
+	void (*glGenTextures)(int, GLuint*);
+	void (*glDeleteTextures)(int, const GLuint*);
+	void (*glBindTexture)(GLenum, GLuint);
+	void (*glTexParameteri)(GLenum, GLenum, GLint);
+	void (*glGetIntegerv)(GLenum, GLint*);
+	GLenum (*glGetError)();
+	bool ok = false;
+};
+
+// Render thread only.
+const GL* _gl() {
+	static GL gl;
+	static bool tried = false;
+	if (tried)
+		return gl.ok ? &gl : nullptr;
+	tried = true;
+	void* lib = dlopen("libEGL.so.1", RTLD_NOW | RTLD_NOLOAD);
+	if (!lib)
+		return nullptr; // Godot draws with GLX or Vulkan: no EGL display to import into
+	auto get_proc = (void* (*)(const char*))dlsym(lib, "eglGetProcAddress");
+	if (!get_proc)
+		return nullptr;
+#define GZ_LOAD(name)                                                                                              \
+	if (!(*(void**)&gl.name = get_proc(#name)))                                                                    \
+		return nullptr;
+	GZ_LOAD(eglGetCurrentDisplay)
+	GZ_LOAD(eglCreateImageKHR)
+	GZ_LOAD(eglDestroyImageKHR)
+	GZ_LOAD(eglGetError)
+	GZ_LOAD(glEGLImageTargetTexture2DOES)
+	GZ_LOAD(glGenTextures)
+	GZ_LOAD(glDeleteTextures)
+	GZ_LOAD(glBindTexture)
+	GZ_LOAD(glTexParameteri)
+	GZ_LOAD(glGetIntegerv)
+	GZ_LOAD(glGetError)
+#undef GZ_LOAD
+	gl.ok = true;
+	return &gl;
+}
+} // namespace
+
+
+bool GoZenZeroCopy::Layout::operator==(const Layout& o) const {
+	if (format != o.format || width != o.width || height != o.height)
+		return false;
+	for (int i = 0; i < 3; i++)
+		if (offset[i] != o.offset[i] || pitch[i] != o.pitch[i])
+			return false;
+	return true;
+}
+
+
+GoZenZeroCopy::~GoZenZeroCopy() {
+	for (Import& import : imports)
+		_free_import(import);
+	for (Held& held : pending)
+		_unref(held);
+	for (Held& held : shown)
+		_unref(held);
+}
+
+
+int64_t GoZenZeroCopy::hold(const AVCodecContext* avctx, const AVFrame* frame, int generation) {
+	if (import_failed || !frame || frame->width <= 0 || frame->height <= 0)
+		return -1;
+	bool nv12 = frame->format == AV_PIX_FMT_NV12;
+	if (!nv12 && frame->format != AV_PIX_FMT_YUV420P)
+		return -1;
+	GozenV4L2Buffer buffer;
+	if (gozen_v4l2_frame_buffer(avctx, frame, &buffer))
+		return -1;
+
+	Held held;
+	held.generation = generation;
+	held.index = buffer.index;
+	held.base = buffer.base;
+	held.length = buffer.length;
+	held.fd = buffer.fd;
+	held.type = buffer.type;
+	held.layout.format = frame->format;
+	held.layout.width = frame->width;
+	held.layout.height = frame->height;
+	for (int i = 0; i < (nv12 ? 2 : 3); i++) {
+		ptrdiff_t offset = frame->data[i] - buffer.base;
+		if (!frame->data[i] || offset < 0 || (size_t)offset >= buffer.length || frame->linesize[i] <= 0)
+			return -1; // a plane outside the decoder's buffer
+		held.layout.offset[i] = (int)offset;
+		held.layout.pitch[i] = frame->linesize[i];
+	}
+	if (!(held.frame = av_frame_clone(frame)))
+		return -1;
+
+	std::lock_guard<std::mutex> lock(mutex);
+	held.id = next_id++;
+	pending.push_back(held);
+	return held.id;
+}
+
+
+void GoZenZeroCopy::drop_pending() {
+	std::deque<Held> dropped;
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		dropped.swap(pending);
+	}
+	for (Held& held : dropped)
+		_unref(held);
+}
+
+
+godot::Array GoZenZeroCopy::show(int64_t id) {
+	Array rids;
+	std::deque<Held> skipped;
+	Held held;
+	{
+		std::lock_guard<std::mutex> lock(mutex);
+		while (!pending.empty() && pending.front().id < id) {
+			skipped.push_back(pending.front());
+			pending.pop_front();
+		}
+		if (!pending.empty() && pending.front().id == id) {
+			held = pending.front();
+			pending.pop_front();
+		}
+	}
+	for (Held& h : skipped)
+		_unref(h);
+	if (!held.frame)
+		return rids;
+
+	int found = -1;
+	for (int i = 0; i < (int)imports.size(); i++) {
+		Import& import = imports[i];
+		if (!import.stale && import.generation == held.generation && import.index == held.index &&
+			import.base == held.base) {
+			if (import.layout == held.layout) {
+				found = i;
+				break;
+			}
+			import.stale = true; // the decoder reallocated its buffers (a new size): the old import is not it
+		}
+	}
+	if (found == -1)
+		found = _import(held);
+	if (found == -1) {
+		_unref(held);
+		return rids;
+	}
+
+	Import& import = imports[found];
+	held.import = found;
+	import.refs++;
+	for (int i = 0; i < import.planes; i++)
+		rids.append(import.rid[i]);
+	shown.push_back(held);
+	while ((int)shown.size() > KEEP_SHOWN + 1) {
+		Held& old = shown.front();
+		if (old.import >= 0 && old.import < (int)imports.size())
+			imports[old.import].refs--;
+		_unref(old);
+		shown.pop_front();
+	}
+
+	// Buffers of an earlier decoder (reopened after a failed restart) go once no shown frame uses them; their slots
+	// are reused so the indices in shown stay valid
+	for (Import& other : imports)
+		if (other.used && other.refs <= 0 && (other.stale || other.generation != held.generation))
+			_free_import(other);
+	return rids;
+}
+
+
+int GoZenZeroCopy::_import(const Held& held) {
+	const GL* gl = _gl();
+	EGLDisplay display = gl ? gl->eglGetCurrentDisplay() : nullptr;
+	if (!display) {
+		UtilityFunctions::print("GoZen: zero-copy unavailable (Godot is not drawing with EGL), copying frames");
+		import_failed = true;
+		return -1;
+	}
+	GozenV4L2Buffer buffer = {nullptr, held.fd, held.type, held.index, (const uint8_t*)held.base, held.length};
+	int dmabuf = gozen_v4l2_export(&buffer);
+	if (dmabuf < 0) {
+		UtilityFunctions::print("GoZen: zero-copy unavailable (VIDIOC_EXPBUF failed: ", dmabuf, "), copying frames");
+		import_failed = true;
+		return -1;
+	}
+
+	Import import;
+	import.generation = held.generation;
+	import.index = held.index;
+	import.base = held.base;
+	import.layout = held.layout;
+	import.used = true;
+	bool nv12 = held.layout.format == AV_PIX_FMT_NV12;
+	int w = held.layout.width, h = held.layout.height, cw = (w + 1) / 2, ch = (h + 1) / 2;
+	struct {
+		uint32_t fourcc;
+		Image::Format format;
+		int width, height;
+	} planes[3] = {{DRM_FORMAT_R8, Image::FORMAT_R8, w, h},
+				   {nv12 ? DRM_FORMAT_GR88 : DRM_FORMAT_R8, nv12 ? Image::FORMAT_RG8 : Image::FORMAT_R8, cw, ch},
+				   {DRM_FORMAT_R8, Image::FORMAT_R8, cw, ch}};
+	import.planes = nv12 ? 2 : 3;
+
+	GLint bound = 0;
+	gl->glGetIntegerv(GL_TEXTURE_BINDING_2D, &bound);
+	bool ok = true;
+	for (int i = 0; i < import.planes && ok; i++) {
+		const EGLint attributes[] = {EGL_WIDTH,
+									 planes[i].width,
+									 EGL_HEIGHT,
+									 planes[i].height,
+									 EGL_LINUX_DRM_FOURCC_EXT,
+									 (EGLint)planes[i].fourcc,
+									 EGL_DMA_BUF_PLANE0_FD_EXT,
+									 dmabuf,
+									 EGL_DMA_BUF_PLANE0_OFFSET_EXT,
+									 held.layout.offset[i],
+									 EGL_DMA_BUF_PLANE0_PITCH_EXT,
+									 held.layout.pitch[i],
+									 EGL_NONE};
+		import.image[i] = gl->eglCreateImageKHR(display, nullptr, EGL_LINUX_DMA_BUF_EXT, nullptr, attributes);
+		if (!import.image[i]) {
+			UtilityFunctions::print("GoZen: zero-copy unavailable (eglCreateImageKHR plane ", i, ": EGL error ",
+									gl->eglGetError(), "), copying frames");
+			ok = false;
+			break;
+		}
+		while (gl->glGetError()) {
+		} // errors left by others
+		gl->glGenTextures(1, &import.texture[i]);
+		gl->glBindTexture(GL_TEXTURE_2D, import.texture[i]);
+		gl->glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		gl->glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		gl->glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		gl->glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		gl->glEGLImageTargetTexture2DOES(GL_TEXTURE_2D, import.image[i]);
+		GLenum error = gl->glGetError();
+		if (error) {
+			UtilityFunctions::print("GoZen: zero-copy unavailable (glEGLImageTargetTexture2DOES plane ", i,
+									": GL error ", (int)error, "), copying frames");
+			ok = false;
+			break;
+		}
+		import.rid[i] = RenderingServer::get_singleton()->texture_create_from_native_handle(
+			RenderingServer::TEXTURE_TYPE_2D, planes[i].format, import.texture[i], planes[i].width, planes[i].height,
+			1);
+		if (!import.rid[i].is_valid()) {
+			UtilityFunctions::print("GoZen: zero-copy unavailable (texture_create_from_native_handle), copying frames");
+			ok = false;
+		}
+	}
+	gl->glBindTexture(GL_TEXTURE_2D, (GLuint)bound);
+	close(dmabuf); // the EGLImages keep the buffer
+	if (!ok) {
+		_free_import(import);
+		import_failed = true;
+		return -1;
+	}
+
+	for (int i = 0; i < (int)imports.size(); i++)
+		if (!imports[i].used) {
+			imports[i] = import;
+			return i;
+		}
+	imports.push_back(import);
+	return (int)imports.size() - 1;
+}
+
+
+void GoZenZeroCopy::_free_import(Import& import) {
+	const GL* gl = _gl();
+	RenderingServer* rs = RenderingServer::get_singleton();
+	for (int i = 0; i < 3; i++) {
+		if (import.rid[i].is_valid() && rs)
+			rs->free_rid(import.rid[i]); // Godot does not delete a texture it did not make
+		if (import.texture[i] && gl)
+			gl->glDeleteTextures(1, &import.texture[i]);
+		if (import.image[i] && gl)
+			gl->eglDestroyImageKHR(gl->eglGetCurrentDisplay(), import.image[i]);
+	}
+	import = Import();
+}
+
+
+void GoZenZeroCopy::_unref(Held& held) {
+	if (held.frame)
+		av_frame_free(&held.frame); // the buffer goes back to the decoder
+	held.frame = nullptr;
+}
+
+
+void GoZenZeroCopy::_delete_on_render_thread(int64_t pointer) {
+	delete (GoZenZeroCopy*)pointer;
+}
+
+
+void GoZenZeroCopy::release(GoZenZeroCopy* zero_copy) {
+	if (!zero_copy)
+		return;
+	zero_copy->drop_pending(); // the decoder gets its buffers back now, not once the render thread runs
+	RenderingServer* rs = RenderingServer::get_singleton();
+	if (!rs)
+		return; // quitting: the GL context is gone, leave it
+	if (rs->is_on_render_thread())
+		delete zero_copy;
+	else
+		rs->call_on_render_thread(callable_mp_static(&GoZenZeroCopy::_delete_on_render_thread).bind((int64_t)zero_copy));
+}
+
+#endif
