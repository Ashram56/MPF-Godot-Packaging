+#pragma once
+
+// gozen_v4l2.c: the V4L2 M2M decoder's buffers for zero-copy, and its restart in place (Linux only).
+#ifdef __linux__
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+struct AVCodecContext;
+struct AVFrame;
+
+typedef struct GozenV4L2Buffer {
+	const void* context; // the decoder instance the buffer belongs to (alive while one of its frames is held)
+	int fd;				 // the decoder's /dev/video* file
+	uint32_t type;		 // V4L2 buffer type (CAPTURE_MPLANE)
+	uint32_t index;		 // the capture buffer's index
+	const uint8_t* base; // where FFmpeg mapped it (the frame's planes are at offsets from here)
+	size_t length;
+} GozenV4L2Buffer;
+
+// 0 and *out filled when frame is a V4L2 M2M decoder's frame in a single buffer, else -1.
+int gozen_v4l2_frame_buffer(const struct AVCodecContext* avctx, const struct AVFrame* frame, GozenV4L2Buffer* out);
+// A new dmabuf fd for the buffer (VIDIOC_EXPBUF), or -errno.
+int gozen_v4l2_export(const GozenV4L2Buffer* buffer);
+// Drops the decoder's queued packets and frames and ends a drain without closing it; 0, or < 0 when it could not
+// (the caller then reopens the decoder). Call avcodec_flush_buffers() first.
+int gozen_v4l2_restart(struct AVCodecContext* avctx);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
