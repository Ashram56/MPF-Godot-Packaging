+// Decodes the next frame into planes the caller owns: [y, u] (NV12), [y, u, v] or [y, u, v, a] (YUVA), each an Image of the size
+// and format of get_y_data() etc. (duplicate() them once). The caller recycles a few sets instead of allocating about 3 MB for
+// every frame; the video's own images are not touched. Returns false when the video is not open or a plane does not fit.
+bool GoZenVideo::next_frame_into(const Array& planes) {
+	if (!loaded)
+		return false;
+	Ref<Image> y = planes.size() > 0 ? Ref<Image>(planes[0]) : Ref<Image>();
+	Ref<Image> u = planes.size() > 1 ? Ref<Image>(planes[1]) : Ref<Image>();
+	Ref<Image> v = planes.size() > 2 ? Ref<Image>(planes[2]) : Ref<Image>();
+	Ref<Image> a = planes.size() > 3 ? Ref<Image>(planes[3]) : Ref<Image>();
+	auto fits = [](const Ref<Image>& dst, const Ref<Image>& own) {
+		return dst.is_valid() && own.is_valid() && dst->get_width() == own->get_width() &&
+			   dst->get_height() == own->get_height() && dst->get_format() == own->get_format();
+	};
+	if (!fits(y, y_data) || !fits(u, u_data) || (!nv12 && !fits(v, v_data)) || (has_alpha && !fits(a, a_data)))
+		return false;
+
+	FFmpeg::get_frame(av_format_ctx.get(), av_codec_ctx.get(), av_stream->index, av_frame.get(), av_packet.get());
+	_copy_frame_data(y.ptr(), u.ptr(), v.ptr(), a.ptr());
+	current_frame++;
+	av_frame_unref(av_frame.get());
+	av_packet_unref(av_packet.get());
+	return true;
+}
