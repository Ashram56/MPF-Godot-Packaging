# /etc/default/mpf-netconfig: environment of the setup page, the Wi-Fi/AP services and the game service
MPF_NETCONFIG_FILE=/boot/efi/mpf-network.txt
MPF_USER=mpf
MPF_WLAN=wlan0
# the GoZen with VAAPI (build/gozen/gozen_vaapi.patch) replaces the one of an installed game bundle, unless the bundle's own
# build says "vaapi" in its bundle.json "gozen" flags
MPF_GOZEN_SO=/home/mpf/MPF-Godot/addons/gde_gozen/bin/libgozen.linux.template_release.x86_64.so
MPF_GOZEN_NEEDS=vaapi
# VAAPI hardware decoding (the game turns it off on a PC without /dev/nvmap unless this is set)
GOZEN_HWDEC=1
MPF_GAME_OVERRIDE=/etc/mpf/game-override.cfg
# the platform checkout whose addons/ and toolchain/addons/ (patched GMC) are installed into bundles that list platform_addons
MPF_PLATFORM_DIR=/home/mpf/MPF-Godot
