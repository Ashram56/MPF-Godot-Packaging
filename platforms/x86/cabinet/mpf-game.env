# /etc/default/mpf-game: Godot's arguments for the game service (game_exec forwards only GODOT and the game's venv
# variable from this file: other environment variables go in /etc/default/mpf-netconfig).
# Empty = the game's own renderer settings (Vulkan on an Intel/AMD GPU). To measure on the cabinet: --max-fps 30,
# --render-thread separate, --audio-output-latency 60 (see platforms/raspberrypi.md for what they gave on a Pi 4).
MPF_GAME_ARGS=
DISPLAY=:0
# the game bundle brings neither Godot nor its Python: the image's own (install/install_linux.sh, in /home/mpf/MPF-Godot)
GODOT=/home/mpf/MPF-Godot/toolchain/godot/Godot_v4.6.3-stable_linux.x86_64
TRON_VENV=/home/mpf/MPF-Godot/.venv
