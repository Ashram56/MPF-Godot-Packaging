MPF_NETCONFIG_FILE=/boot/firmware/mpf-network.txt
MPF_USER=pi
MPF_WLAN=wlan0
MPF_GOZEN_SO=/home/pi/MPF-Godot/addons/gde_gozen/bin/libgozen.linux.template_release.arm64.so
# The Pi 5 has no H.264 decoder and its HEVC decoder (rpi-hevc-dec) is a stateless V4L2 one that this GoZen build does
# not drive: until a GoZen with FFmpeg's v4l2-request hwaccel is installed, videos decode in software (four A76 cores).
# MPF_GOZEN_NEEDS is emptied so that a bundle's own GoZen is kept (it has no Pi 5 specific build to replace it with).
GOZEN_HWDEC=0
MPF_GOZEN_NEEDS=
# ALSA reports 0 output latency while it holds tens of ms: the video clock subtracts this (seconds; measured on a Pi 4)
GOZEN_AUDIO_LATENCY=0.06
