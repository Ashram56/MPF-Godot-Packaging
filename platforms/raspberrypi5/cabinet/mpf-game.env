# /etc/default/mpf-game: Godot's arguments for the game service (game_exec forwards only GODOT and the game's venv
# variable from this file: other environment variables go in /etc/default/mpf-netconfig).
# GLES3 on the Pi 5's V3D 7.1. 30 FPS cap as on every platform (owner decision 2026-10-25): raise it once measured on a Pi 5.
# Keep the line free of options a game's launcher might not accept.
MPF_GAME_ARGS=-- --rendering-driver opengl3 --max-fps 30
DISPLAY=:0
# the game bundle brings neither Godot nor its Python: the image's own (install/install_linux.sh, in /home/pi/MPF-Godot)
GODOT=/home/pi/MPF-Godot/toolchain/godot/Godot_v4.6.3-stable_linux.arm64
MPF_GAME_VENV=/home/pi/MPF-Godot/.venv
# a game that reads its venv from another name (Transformers: TF_VENV) gets it from any *_VENV line of this file
TF_VENV=/home/pi/MPF-Godot/.venv
