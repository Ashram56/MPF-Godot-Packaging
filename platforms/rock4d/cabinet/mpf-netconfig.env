MPF_NETCONFIG_FILE=/boot/firmware/mpf-network.txt
MPF_USER=rock
MPF_WLAN=wlan0
MPF_GOZEN_SO=/home/rock/MPF-Godot/addons/gde_gozen/bin/libgozen.linux.template_release.arm64.so
# Hardware video decoding: see GOZEN_HWDEC below and platforms/rock4d.md ("Video"). MPF_GOZEN_NEEDS is emptied so that a
# bundle's own GoZen is kept unless the image carries the one with the v4l2-request decoder.
GOZEN_HWDEC=0
MPF_GOZEN_NEEDS=
# ALSA reports 0 output latency while it holds tens of ms: the video clock subtracts this (seconds)
GOZEN_AUDIO_LATENCY=0.06
