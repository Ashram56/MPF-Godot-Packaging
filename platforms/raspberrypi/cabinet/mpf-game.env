# /etc/default/mpf-game: Godot's arguments for the game service. game_exec forwards only GODOT (and the game's
# venv variable) from this file: other environment variables go in /etc/default/mpf-netconfig.
MPF_GAME_ARGS=-- --rendering-driver opengl3 --render-thread separate --max-fps 30 --audio-output-latency 60
# a Godot 4.6.3 built with build/godot/egl_release_current.patch (official 4.6.3 crashes with --render-thread separate)
GODOT=/home/pi/MPF-Godot/toolchain/godot/Godot_v4.6.3-stable-eglmt_linux.arm64
DISPLAY=:0
