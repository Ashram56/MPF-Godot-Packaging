# Lines added to /etc/default/mpf-netconfig (the services' EnvironmentFile, inherited by the game)
# hardware decoder + zero-copy: only with the fixed bcm2835-codec module (bcm2835-codec-flush-completion.patch)
GOZEN_HWDEC=1
# ALSA reports 0 output latency while it holds 58-93 ms: the video clock subtracts this (seconds)
GOZEN_AUDIO_LATENCY=0.087
