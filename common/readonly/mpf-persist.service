[Unit]
Description=MPF data partition and persistent folders (read-only production mode)
DefaultDependencies=no
After=local-fs-pre.target systemd-udevd.service systemd-udev-trigger.service
Before=local-fs.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/mpf-persist
TimeoutStartSec=300

[Install]
WantedBy=local-fs.target
