{
 "id": "transformers-mpf",
 "name": "Transformers Pro (Stern 2011), MPF recreation",
 "repo": "https://github.com/Ashram56/Transformers-MPF.git",
 "ref": "main",
 "submodules": false,
 "tools": [
  "git",
  "ffmpeg"
 ],
 "disk_gb": 12,
 "min_python": "3.11",
 "needs": [
  "git",
  "ffmpeg",
  "python3 (3.11 or newer)",
  "an internet connection (Godot, MPF and the ROM-derived assets are downloaded by the game's setup)",
  "about 12 GB of free disk and 30 to 60 minutes the first time"
 ],
 "setup": [
  [
   "{python}",
   "scripts/setup.py",
   "--no-monitor"
  ]
 ],
 "spec": "specs/transformers-mpf.json",
 "spec_globs": [
  "rom/mpf_package/media/dmd/deffs/deff_*/timing.json"
 ],
 "env": {
  "MPF_GODOT_PACKAGING": "{platform}"
 },
 "target": "all",
 "publish_folder": "transformers"
}